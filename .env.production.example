# Armario Digital - variaveis de producao. Copie para ".env.production" (nunca
# versionado, ja esta no .gitignore) e preencha os valores reais SO no host
# onde o deploy realmente roda (o VPS - ver docker-compose.production.yml,
# cabecalho, para o motivo de nao poder rodar este compose localmente).

# Senha nova, so para a role dona do schema (armario_owner). Usada so pelo
# Prisma Migrate, nunca em runtime.
POSTGRES_OWNER_PASSWORD=

# Senha nova, so para a role de runtime (armario_app). E sobre ela que a Row
# Level Security realmente vale.
POSTGRES_APP_PASSWORD=

# String aleatoria forte (ex: openssl rand -hex 32). Assina as sessoes locais
# de Professor - nunca reaproveite a de outro modulo/ambiente.
SESSION_SECRET=

# OBRIGATORIA sempre (env.ts recusa subir sem isto, min 16 caracteres) -
# autentica as chamadas SERVIDOR-A-SERVIDOR que chegam de fora (Core/site
# chamando /internal/offboard, /internal/setup etc.), independente de este
# modulo falar ou nao com uma Core real (ver CORE_API_URL abaixo).
#
# Se voce AINDA NAO tem o valor real ja configurado do lado da Core: gere
# qualquer string aleatoria forte por enquanto (ex: openssl rand -hex 32) -
# o modulo sobe normalmente em modo local (MockCoreClient, mesmo
# comportamento do dev). So quando CORE_API_URL (abaixo) tambem for
# preenchido apontando pra Core real e que este valor PRECISA ser
# EXATAMENTE o mesmo configurado la (INTERNAL_TOKEN no .env.production da
# Core) - trocar os dois depois e so isso, nenhum codigo muda.
CORE_INTERNAL_TOKEN=

# Deixe SEM VALOR (comentado) para o modulo rodar em modo local
# (MockCoreClient - login/cadastro/reservas funcionam, sem tenant real da
# Core ainda). Preencha com a URL da Core real (ex: http://novatech-core:3400,
# alias da rede "platform" - ver docker-compose.production.yml) quando for
# ligar a integracao de verdade.
# CORE_API_URL=
